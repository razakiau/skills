{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/strategic-programming/scripts/sp.mjs\" turn",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/strategic-programming/scripts/sp.mjs\" ask",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|edit|create|apply_patch|bash|Bash|powershell|replace_string_in_file|create_file|insert_edit_into_file|multi_replace_string_in_file|run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/strategic-programming/scripts/sp.mjs\" edited",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/strategic-programming/scripts/sp.mjs\" asked",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/foundry/scripts/foundry.mjs\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/strategic-programming/scripts/sp.mjs\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
